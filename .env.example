# EraHerm-Memory local config
# 用法：copy .env.example .env（Unix: cp .env.example .env）
#
# 默认值即可在本机跑通：绑定 127.0.0.1 + 无认证。
# 一旦把 ERAHERM_HOST 改成 0.0.0.0/::（可从其它机器访问），**必须**同时设置
# ERAHERM_API_TOKEN，否则进程会拒绝启动（见 app/security.py）。

ERAHERM_DATA_DIR=./storage
ERAHERM_DATABASE_URL=sqlite:///./storage/eraherm.db
# 只绑定本机。要对外提供服务：改成 0.0.0.0，并设置下面的 API_TOKEN
ERAHERM_HOST=127.0.0.1
ERAHERM_PORT=8000

# --- 认证（0.10.2 新增）------------------------------------------------------
# 设置后，/v1/*（除 /v1/health）一律要求 X-API-Token 或 Authorization: Bearer。
# 建议：python -c "import secrets;print(secrets.token_urlsafe(32))"
# ERAHERM_API_TOKEN=
# /v1/admin/* 需要它。**不设置 = admin 端点一律 503（fail-closed）**，
# 不再有可猜的默认口令。
# ERAHERM_ADMIN_TOKEN=
# 明确承认「我要无认证暴露到网络」才需要（不推荐）
# ERAHERM_ALLOW_INSECURE_PUBLIC=false
# Demo 前端与 API 同源；生产建议关掉（否则等于给 XSS 留一个落地页）
# ERAHERM_ENABLE_DEMO=true
# /docs /redoc /openapi.json：生产建议关掉（默认开，方便本地调试）
# ERAHERM_ENABLE_DOCS=true
# 运行时建表（create_all）：嵌入式/测试方便。生产建议 false，只走 alembic upgrade head
# ERAHERM_AUTO_CREATE_SCHEMA=true
# 进程内令牌桶限流（防误用；多 worker 各自计数，不是分布式限流）
# ERAHERM_RATE_LIMIT_ENABLED=true
# ERAHERM_RATE_LIMIT_PER_MINUTE=600
# ERAHERM_RATE_LIMIT_BURST=120

# memory_policy
ERAHERM_DECAY_LAMBDA_DEFAULT=0.05
ERAHERM_PROMOTION_IMPORTANCE_THRESHOLD=0.6
ERAHERM_RECALL_TOP_K_DEFAULT=8
ERAHERM_RECALL_PINNED_CAP=20

# --- 召回门禁（ADR 0010 / 0011）--------------------------------------------
# 门禁判**相关性**（与记忆年龄解耦），不再判绝对分。
# 有词法重叠 / 零词法重叠两档：
ERAHERM_RECALL_REL_MIN=0.18
ERAHERM_RECALL_REL_MIN_NO_LEXICAL=0.55
# 回滚开关：score = 旧绝对分门禁（=ADR 0010 之前的行为）
ERAHERM_RECALL_GATE_MODE=relevance
#
# 下面两个是**旧的绝对分**旋钮，保留只为兼容老配置：
# 在 relevance 模式下会按「默认点比例」折算成相关性下限（连续、单调）：
#   rel_min = ERAHERM_RECALL_REL_MIN × (值 / 默认值0.25)
#   rel_min_no_lexical = ERAHERM_RECALL_REL_MIN_NO_LEXICAL × (值 / 默认值0.38)
# 保持默认即等于用上面的相关性默认值；0 = 关闭该档门禁。
# 例：0.26 → 0.1872（更严）、0.20 → 0.144（更松）。
ERAHERM_RECALL_MIN_SCORE=0.25
ERAHERM_RECALL_MIN_SCORE_NO_LEXICAL=0.38

# 排序：relevance 主导 + base 小幅破平（base 在候选集内归一化）
ERAHERM_RECALL_RANK_BASE_WEIGHT=0.2
ERAHERM_RECALL_RANK_BASE_NORMALIZE=true
# 命中增稳（间隔重复轻量版）：λ_eff = λ / boost，boost = min(1+α·ln(1+n), cap)
ERAHERM_RECALL_HIT_BOOST_ENABLED=true
ERAHERM_RECALL_HIT_BOOST_ALPHA=0.35
ERAHERM_RECALL_HIT_BOOST_CAP=3.0
# 硬护栏：有效半衰期不得超过该天数（防「永生条目」）
ERAHERM_RECALL_MAX_HALF_LIFE_DAYS=365.0
# 长文词法折扣阈值（超过该字数后零星命中按长度二次折扣）
ERAHERM_RECALL_LEXICAL_LEN_NORM=300
# pinned（身份/红线/偏好）不参与年龄衰减
ERAHERM_RECALL_PINNED_NO_DECAY=true
ERAHERM_RECALL_PINNED_SCORE_BOOST=0.05
# 已取代（superseded_by 非空）的记忆是否从召回中排除。不删除、可审计，只是不再竞争。
# 纠正即进化靠它兑现「旧版让路」（见 ADR 0013）。
ERAHERM_RECALL_EXCLUDE_SUPERSEDED=true

ERAHERM_L1_MAX_ITEMS_PER_SESSION=200
ERAHERM_AUTO_IMPORTANCE=true
ERAHERM_RECALL_VECTOR_WEIGHT=0.7
ERAHERM_EXTRACT_ON_REMEMBER=true

# graph_policy
ERAHERM_GRAPH_MAX_HOPS_DEFAULT=2
ERAHERM_GRAPH_MIN_EXTRACT_CONFIDENCE=0.5
# impact 路径枚举上限（不设上限时 max_hops=5 + 高度数会组合爆炸）
ERAHERM_GRAPH_MAX_PATHS=200

# feedback_policy
ERAHERM_REFLECTION_CONFIDENCE_THRESHOLD=0.7
ERAHERM_UPVOTE_WEIGHT_DELTA=0.05
ERAHERM_DOWNVOTE_WEIGHT_DELTA=-0.1
ERAHERM_CORRECT_CREATES_PINNED=true
ERAHERM_DOWNVOTE_WRITES_NEGATIVE_MEMORY=true

# ops / observability
ERAHERM_LOG_LEVEL=INFO
ERAHERM_JSON_LOGS=true

# phase 6 backends
ERAHERM_SESSION_CACHE_BACKEND=memory
# ERAHERM_SESSION_CACHE_BACKEND=redis
# ERAHERM_REDIS_URL=redis://localhost:6379/0
ERAHERM_VECTOR_BACKEND=sqlite
# ERAHERM_VECTOR_BACKEND=qdrant
# ERAHERM_QDRANT_URL=http://localhost:6333
# ERAHERM_QDRANT_PATH=./storage/qdrant
ERAHERM_GRAPH_BACKEND=networkx
# ERAHERM_GRAPH_BACKEND=neo4j
# ERAHERM_NEO4J_URI=bolt://localhost:7687
# ERAHERM_NEO4J_USER=neo4j
# ERAHERM_NEO4J_PASSWORD=password
ERAHERM_FEEDBACK_ASYNC=false

# LLM extract / reflection: heuristic (default) | openai
# heuristic = 本地规则/启发式（零成本、零出网）；openai = OpenAI 兼容端点（DeepSeek 等）
#
# 关于「敏感内容不出网」——请读 ADR 0014，不要只看这一行：
#   1) app/sensitive.py 是**中文关键词表**，不是 DLP。它拦不住「我的密码是 hunter2」。
#   2) LLM 抽取/反射/压缩三处出网点都会检查该词表；命中即回落本地规则。
#   3) embedding 路径：若用远端 embedding（openai）且内容命中词表，**请求会被拒绝**
#      （fail-closed，返回 400），而不是静默外发。这就是下面这个开关的作用。
ERAHERM_LLM_BACKEND=heuristic
# ERAHERM_LLM_BACKEND=openai
# ERAHERM_LLM_API_KEY=sk-...
ERAHERM_LLM_MODEL=gpt-4o-mini
# ERAHERM_LLM_BASE_URL=https://api.deepseek.com
# 远端 embedding + 命中敏感词 = 拒绝入库。设 false 表示你接受正文外发的风险。
ERAHERM_SENSITIVE_REQUIRES_LOCAL_EMBEDDING=true

# embedding
# hashing = 仅离线 / CI / 本地 Demo（语义弱，禁止用于 Hermes 生产）
ERAHERM_EMBEDDING_BACKEND=hashing
ERAHERM_EMBEDDING_DIM=256
# --- 生产 / Hermes（二选一，并改掉上面的 hashing）---
# A) 本地真实语义（推荐中文）：pip install 'eraherm-memory[fastembed]'
# ERAHERM_EMBEDDING_BACKEND=fastembed
# ERAHERM_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ERAHERM_EMBEDDING_DIM=512
# ERAHERM_EMBEDDING_CACHE_DIR=./storage/fastembed
# B) OpenAI 兼容 API（需要 API KEY，否则启动直接失败）
# ERAHERM_EMBEDDING_BACKEND=openai
# ERAHERM_EMBEDDING_API_KEY=sk-...
# ERAHERM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ERAHERM_EMBEDDING_MODEL=text-embedding-3-small
# ERAHERM_EMBEDDING_DIM=1536

# phase 7 proactive (Host 可忽略返回字段；关闭即不计算)
ERAHERM_PROACTIVE_ALERTS_ENABLED=true
ERAHERM_PROACTIVE_RECOMMEND_ENABLED=true
# ERAHERM_ALERT_SIMILARITY_THRESHOLD=0.35
# ERAHERM_RECOMMEND_TOP_K=3
# ERAHERM_RECOMMEND_MIN_SCORE=0.2

# phase 8 consolidation (opt-in nightly job inside API process)
# 注意：整理是**破坏性**的（冲突软删 + 低权重遗忘 + 压缩后删原文）。
# 现在有三道安全网：
#   1) POST /v1/admin/consolidate {"dry_run": true} / eraherm-consolidate --dry-run 先看会动什么
#   2) 删除前自动 L3 归档（consolidation_archive_before_delete）
#   3) POST /v1/admin/memories/restore 与 POST /v1/admin/l3/restore 可以恢复
# 多 worker 部署时每个进程都会起一份 scheduler，但有跨进程文件锁兜底
# （只有一个进程真正执行）；更推荐用独立进程跑 CLI。
ERAHERM_CONSOLIDATION_ENABLED=false
# ERAHERM_CONSOLIDATION_CRON_HOUR=3
# ERAHERM_CONSOLIDATION_CRON_MINUTE=0
# ERAHERM_CONSOLIDATION_USE_LLM=false
# ERAHERM_CONSOLIDATION_FORGET_WEIGHT_THRESHOLD=0.12
# ERAHERM_CONSOLIDATION_CLUSTER_MIN_SIZE=3
# 删除前自动归档（归档失败则放弃删除）
ERAHERM_CONSOLIDATION_ARCHIVE_BEFORE_DELETE=true
# 聚类候选上限：全对全相似度是 O(N²)，不设上限时大库夜间任务跑不完
# ERAHERM_CONSOLIDATION_MAX_CANDIDATES=2000
# 跨进程整理锁的过期秒数（进程崩溃后下一个持锁者接管）
# ERAHERM_CONSOLIDATION_LOCK_STALE_SECONDS=21600

# 进程内队列 / L1 会话缓存的容量上限（防无界增长）
# ERAHERM_JOB_QUEUE_MAX_SIZE=1000
# ERAHERM_SESSION_CACHE_MAX_SESSIONS=2000

# phase 9 watchdog（零 LLM / 零外部 API 巡检）
# ERAHERM_WATCHDOG_SCAN_LIMIT=200
# ERAHERM_WATCHDOG_GEM_IMPORTANCE=0.8
# ERAHERM_WATCHDOG_MAX_GEMS=3
# ERAHERM_WATCHDOG_LOW_WEIGHT=0.12
