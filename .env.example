# EraHerm-Memory local config
ERAHERM_DATA_DIR=./storage
ERAHERM_DATABASE_URL=sqlite:///./storage/eraherm.db
ERAHERM_HOST=0.0.0.0
ERAHERM_PORT=8000

# memory_policy
ERAHERM_DECAY_LAMBDA_DEFAULT=0.05
ERAHERM_PROMOTION_IMPORTANCE_THRESHOLD=0.6
ERAHERM_RECALL_TOP_K_DEFAULT=8
ERAHERM_RECALL_PINNED_CAP=20
ERAHERM_L1_MAX_ITEMS_PER_SESSION=200
ERAHERM_AUTO_IMPORTANCE=true
ERAHERM_RECALL_VECTOR_WEIGHT=0.7
ERAHERM_EXTRACT_ON_REMEMBER=true

# graph_policy
ERAHERM_GRAPH_MAX_HOPS_DEFAULT=2
ERAHERM_GRAPH_MIN_EXTRACT_CONFIDENCE=0.5

# feedback_policy
ERAHERM_REFLECTION_CONFIDENCE_THRESHOLD=0.7
ERAHERM_UPVOTE_WEIGHT_DELTA=0.05
ERAHERM_DOWNVOTE_WEIGHT_DELTA=-0.1
ERAHERM_CORRECT_CREATES_PINNED=false
ERAHERM_DOWNVOTE_WRITES_NEGATIVE_MEMORY=true

# ops / observability
ERAHERM_ADMIN_TOKEN=dev-admin-token
ERAHERM_LOG_LEVEL=INFO
ERAHERM_JSON_LOGS=true

# phase 6 backends
ERAHERM_SESSION_CACHE_BACKEND=memory
# ERAHERM_SESSION_CACHE_BACKEND=redis
# ERAHERM_REDIS_URL=redis://localhost:6379/0
ERAHERM_VECTOR_BACKEND=sqlite
# ERAHERM_VECTOR_BACKEND=qdrant
# ERAHERM_QDRANT_URL=http://localhost:6333
# ERAHERM_QDRANT_PATH=./storage/qdrant
ERAHERM_GRAPH_BACKEND=networkx
# ERAHERM_GRAPH_BACKEND=neo4j
# ERAHERM_NEO4J_URI=bolt://localhost:7687
# ERAHERM_NEO4J_USER=neo4j
# ERAHERM_NEO4J_PASSWORD=password
ERAHERM_FEEDBACK_ASYNC=false

# LLM extract / reflection: heuristic (default) | openai
ERAHERM_LLM_BACKEND=heuristic
# ERAHERM_LLM_BACKEND=openai
# ERAHERM_LLM_API_KEY=sk-...
# ERAHERM_LLM_MODEL=gpt-4o-mini
# ERAHERM_LLM_BASE_URL=https://api.openai.com/v1

# embedding: hashing (default, offline) | openai
ERAHERM_EMBEDDING_BACKEND=hashing
ERAHERM_EMBEDDING_DIM=256
# ERAHERM_EMBEDDING_BACKEND=openai
# ERAHERM_EMBEDDING_API_KEY=sk-...
# ERAHERM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ERAHERM_EMBEDDING_MODEL=text-embedding-3-small

# phase 7 proactive (Host 可忽略返回字段；关闭即不计算)
ERAHERM_PROACTIVE_ALERTS_ENABLED=true
ERAHERM_PROACTIVE_RECOMMEND_ENABLED=true
# ERAHERM_ALERT_SIMILARITY_THRESHOLD=0.35
# ERAHERM_RECOMMEND_TOP_K=3
# ERAHERM_RECOMMEND_MIN_SCORE=0.2

# phase 8 consolidation (opt-in nightly job inside API process)
ERAHERM_CONSOLIDATION_ENABLED=false
# ERAHERM_CONSOLIDATION_CRON_HOUR=3
# ERAHERM_CONSOLIDATION_CRON_MINUTE=0
# ERAHERM_CONSOLIDATION_USE_LLM=false
# ERAHERM_CONSOLIDATION_FORGET_WEIGHT_THRESHOLD=0.12
# ERAHERM_CONSOLIDATION_CLUSTER_MIN_SIZE=3
