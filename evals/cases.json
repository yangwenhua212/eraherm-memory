[
  {
    "id": "pin_identity_survives",
    "suite": "pinned",
    "description": "钉死身份记忆在会话关闭后仍可召回",
    "steps": [
      {"op": "session_create", "user_id": "eval_pin"},
      {
        "op": "remember",
        "user_id": "eval_pin",
        "content": "用户名为 cc",
        "memory_type": "identity",
        "pinned": true,
        "importance": 1.0,
        "extract_graph": false
      },
      {
        "op": "remember",
        "user_id": "eval_pin",
        "content": "今天天气不错",
        "memory_type": "episode",
        "importance": 0.1,
        "extract_graph": false
      },
      {"op": "session_close"},
      {
        "op": "recall",
        "user_id": "eval_pin",
        "query": "用户名是什么",
        "expect_any_contains": ["cc"]
      }
    ]
  },
  {
    "id": "correct_then_recall",
    "suite": "feedback",
    "description": "纠正 MySQL→PostgreSQL 后召回命中修订事实",
    "steps": [
      {
        "op": "remember",
        "user_id": "eval_fb",
        "content": "数据库使用 MySQL",
        "importance": 0.9,
        "extract_graph": false,
        "save_as": "wrong_mem"
      },
      {
        "op": "feedback",
        "user_id": "eval_fb",
        "answer_id": "ans_eval_1",
        "feedback_type": "correct",
        "correction_text": "应该是 PostgreSQL 不是 MySQL",
        "related_from": "wrong_mem",
        "expect_status": "accepted"
      },
      {
        "op": "recall",
        "user_id": "eval_fb",
        "query": "数据库是 PostgreSQL 吗",
        "expect_any_contains": ["PostgreSQL"]
      }
    ]
  },
  {
    "id": "impact_inbound_a",
    "suite": "graph",
    "description": "改 A 服务会影响依赖它的 C 服务",
    "steps": [
      {
        "op": "extract",
        "user_id": "eval_g",
        "text": "A服务依赖B服务和Redis。C服务依赖A服务。"
      },
      {
        "op": "impact",
        "user_id": "eval_g",
        "entity_name": "A服务",
        "direction": "inbound",
        "max_hops": 2,
        "expect_node_names": ["C服务"]
      }
    ]
  },
  {
    "id": "impact_outbound_a",
    "suite": "graph",
    "description": "A 服务出边应包含 B 与 Redis",
    "steps": [
      {
        "op": "extract",
        "user_id": "eval_g2",
        "text": "A服务依赖B服务和Redis。"
      },
      {
        "op": "impact",
        "user_id": "eval_g2",
        "entity_name": "A服务",
        "direction": "outbound",
        "max_hops": 2,
        "expect_node_names": ["B服务", "Redis"]
      }
    ]
  },
