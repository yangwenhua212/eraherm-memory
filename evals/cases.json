[
  {
    "id": "pin_identity_survives",
    "suite": "pinned",
    "description": "钉死身份记忆在会话关闭后仍可召回",
    "steps": [
      {"op": "session_create", "user_id": "eval_pin"},
      {
        "op": "remember",
        "user_id": "eval_pin",
        "content": "用户名为 cc",
        "memory_type": "identity",
        "pinned": true,
        "importance": 1.0,
        "extract_graph": false
      },
      {
        "op": "remember",
        "user_id": "eval_pin",
        "content": "今天天气不错",
        "memory_type": "episode",
        "importance": 0.1,
        "extract_graph": false
      },
      {"op": "session_close"},
      {
        "op": "recall",
        "user_id": "eval_pin",
        "query": "用户名是什么",
        "expect_any_contains": ["cc"]
      }
    ]
  },
  {
    "id": "correct_then_recall",
